# ==============================================================================
# Navidrome Environment Variables
# ==============================================================================

# --- Scrobbling Integration ---
# The local IP address (or Docker network hostname) of your Koito instance.
# Since Navidrome and Koito are on the same 'container-share-net', using the 
# Unraid Host IP or simply 'koito' (if Docker DNS resolves it properly) works here.
# Example: 192.168.1.100
KOITO_IP=

# --- Legacy Variables ---
# DEPRECATED: Previously used for direct scrobbling authentication, now handled 
# by Koito upstream. Kept for historical reference.
#SCROBBLE_TOKEN=