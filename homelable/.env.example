# ==============================================================================
# Homelable Environment Variables
# ==============================================================================

# --- Core & Security ---
# Secret key used for session/JWT encryption. 
# Generate a random string (e.g., `openssl rand -hex 32`)
SECRET_KEY=

# Allowed Cross-Origin Resource Sharing domains. 
# Use "*" for all, or specify your domain (e.g., "http://192.168.1.100:3030, https://homelable.mydomain.com")
CORS_ORIGINS=*

# --- Authentication ---
# Authentication mode (e.g., 'basic' or 'none' if protected by an external IdP/Cloudflare Access)
AUTH_MODE=basic
# Admin username for the dashboard
AUTH_USERNAME=admin
# Hashed password for the admin user (generate using bcrypt or the app's specific hashing tool)
AUTH_PASSWORD_HASH=

# --- Network Scanner ---
# IP subnets the backend will actively scan to discover homelab nodes.
# E.g., "192.168.1.0/24" for physical network, or Docker subnets.
SCANNER_RANGES=192.168.1.0/24

# IP subnets specifically targeted for HTTP/HTTPS probes to identify web services.
SCANNER_HTTP_RANGES=192.168.1.0/24

# Enable or disable active HTTP probing (true/false)
SCANNER_HTTP_PROBE_ENABLED=true

# Whether the HTTP probe should reject invalid/self-signed TLS certificates (true/false).
# Usually set to 'false' in a homelab environment to allow self-signed certs.
SCANNER_HTTP_VERIFY_TLS=false

# How often (in seconds) the backend checks the online/offline status of known services.
STATUS_CHECKER_INTERVAL=60

# --- Integrations & API Keys ---
# API keys for external integrations (e.g., Homepage dashboards, MCP services, etc.)
# Leave blank if not utilized.
MCP_API_KEY=
MCP_SERVICE_KEY=

# Key required to access the read-only live view dashboard without authentication.
LIVEVIEW_KEY=

# API key for integrating Homelable data directly into a Homepage instance.
HOMEPAGE_API_KEY=