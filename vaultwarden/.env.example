# ==============================================================================
# Vaultwarden Environment Variables
# ==============================================================================

# --- Cloudflare Tunnel ---
# The token for the DEDICATED Cloudflare tunnel for Vaultwarden. 
# Do not reuse the token from your other media/general services.
TUNNEL_TOKEN=

# --- Email / SMTP Configuration ---
# Required for 2FA, new device login alerts, and account verifications.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Domain & Routing ---
# The external domain used to access Vaultwarden. Must match exactly, including https://
DOMAIN=https://vault.mydomain.com

# Ensure Vaultwarden correctly identifies the client IP coming through the Cloudflare proxy.
IP_HEADER=X-Forwarded-For

# --- Registration & Security ---
# Set to 'true' only to create your initial account. Once created, 
# set to 'false' and redeploy to prevent strangers from registering on your domain.
SIGNUPS_ALLOWED=false

# Forces new accounts to verify their email before logging in.
SIGNUPS_VERIFY=true

# Allow users to leave password hints (generally discouraged for security).
SHOW_PASSWORD_HINT=false
PASSWORD_HINTS_ALLOWED=false

# Allows org admins to invite users, even when signups are disabled globally.
INVITATIONS_ALLOWED=false
INVITATION_ORG_NAME=

# --- Admin Interface ---
# Secures the /admin dashboard. DO NOT use plain text!
# Generate an Argon2 hash using the command: `vaultwarden hash` 
# or use a secure online Argon2 generator.
ADMIN_TOKEN=

# --- Push Notifications (Bitwarden Clients) ---
# Allows mobile apps to sync immediately when a password is changed elsewhere.
# Obtain your free Installation ID and Key at: https://bitwarden.com/host
PUSH_ENABLED=true
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=

# Using Bitwarden's EU servers for privacy/GDPR compliance. 
# (Change to .com if you prefer the US servers).
PUSH_RELAY_URI=https://api.bitwarden.eu
PUSH_IDENTITY_URI=https://identity.bitwarden.eu

# --- Database Settings ---
# Auto-purges items sitting in the trash for more than 30 days.
TRASH_AUTO_DELETE_DAYS=30

# Enables Write-Ahead Logging (WAL) for SQLite. 
# Crucial for performance and preventing database locks in a concurrent environment.
ENABLE_DB_WAL=true