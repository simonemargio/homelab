# ==============================================================================
# Cloudflare Tunnel Environment Variables
# ==============================================================================

# INSTRUCTIONS:
# 1. Log in to your Cloudflare Dashboard and navigate to Zero Trust.
# 2. Go to Networks -> Tunnels.
# 3. Click "Create a tunnel" (choose Cloudflared).
# 4. Name your tunnel and select "Docker" as your environment.
# 5. Cloudflare will provide a run command. Extract the long alphanumeric string 
#    located right after "--token".
# 6. Paste that string below.

# The authentication token for the Cloudflare Tunnel
TUNNEL_TOKEN=