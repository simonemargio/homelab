# ==============================================================================
# Music stack
# ==============================================================================

# --- File System Permissions ---
# The User ID and Group ID that the containers will use to read and write files.
# It is critical that these match the ID of the user owning the mounted directories
# on the host (often 99 on Unraid or 1000 on standard Linux systems) to avoid 
# permission errors.
PUID=
PGID=

# --- Download Paths ---
# The primary download path used by torrent clients (e.g., qBittorrent, Transmission) 
# to save incoming media.
# Example: /mnt/cache/media/download/lidarr
DOWNLOAD_TORRENT_PATH=

# The specific download path used by the Slskd container. 
# IMPORTANT: This must share the same root path as DOWNLOAD_TORRENT_PATH, 
# but reside in a dedicated user-created subdirectory. This allows services 
# like Lidarr to import files seamlessly via hardlinks or atomic moves.
# Example: /mnt/cache/media/download/lidarr/slskd
DOWNLOAD_SLSKD_PATH=

# --- Lidarr container ---
# The root path mapped to Lidarr.
LIDARR_PATH=

# --- Media Management Paths ---
# The root path mapped to Navidrome to scan and serve your music collection.
# Example: /mnt/user/media/music
NAVIDROME_MUSIC_PATH=