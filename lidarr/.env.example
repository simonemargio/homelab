# ==============================================================================
# Music stack
# ==============================================================================

# --- File System Permissions ---
# The User ID and Group ID that the containers will use to read and write files.
# It is critical that these match the ID of the user owning the mounted directories
# on the host (often 99 on Unraid or 1000 on standard Linux systems) to avoid 
# permission errors.
PUID=
PGID=

# --- Download Paths ---
# The primary download path used by torrent clients (e.g., qBittorrent, Transmission) 
# to save incoming media.
# Example: /mnt/cache/media/download/lidarr
DOWNLOAD_TORRENT_PATH=

# The specific download path used by the Slskd container. 
# IMPORTANT: This must share the same root path as DOWNLOAD_TORRENT_PATH, 
# but reside in a dedicated user-created subdirectory. This allows services 
# like Lidarr to import files seamlessly via hardlinks or atomic moves.
# Example: /mnt/cache/media/download/lidarr/slskd
DOWNLOAD_SLSKD_PATH=

# --- Lidarr container ---
# The root path mapped to Lidarr.
LIDARR_PATH=

# --- Media Management Paths ---
# The root path mapped to Navidrome to scan and serve your music collection.
# Example: /mnt/user/media/music
NAVIDROME_MUSIC_PATH=

# ==============================================================================
# Sonobarr Environment Variables
# ==============================================================================

# --- Directory Paths ---
# The local host path where Sonobarr will store its persistent configuration, 
# logs, and internal database.
SONOBARR_CONFIG_PATH=

# --- Application Security ---
# A long, randomly generated secret string used to encrypt internal sessions 
# and cookies. Do not change this after the initial setup.
SECRET_KEY=

# --- Lidarr Integration ---
# The internal URL where Sonobarr can reach the Lidarr API. Since they share 
# a Docker network, the container name and internal port are used.
LIDARR_ADDRESS=http://lidarr:8686

# The API key generated from your Lidarr instance (found in Settings > General).
LIDARR_API_KEY=

# The internal destination path inside Lidarr where newly discovered music 
# should be saved. This usually matches Lidarr's mapped library volume.
ROOT_FOLDER_PATH=

# The ID of the Quality Profile to assign to newly added artists. 
# In Lidarr, "1" is typically the default "Any" profile.
QUALITY_PROFILE_ID=1

# The ID of the Metadata Profile to use for new artists. 
# In Lidarr, "1" is typically the default "Standard" profile.
METADATA_PROFILE_ID=1

# Determines whether Lidarr should automatically trigger a search for missing 
# albums as soon as Sonobarr adds a new artist.
SEARCH_FOR_MISSING_ALBUMS=true

# --- External APIs (Last.fm) ---
# Credentials required to fetch recommendations, artist similarities, and metadata.
# You must register an API account on Last.fm to obtain these.
LAST_FM_API_KEY=
LAST_FM_API_SECRET=

# --- Web GUI Authentication ---
# Super-admin bootstrap credentials. These are used only on the first launch 
# to provision your initial administrative account.
SONOBARR_SUPERADMIN_USERNAME=admin
SONOBARR_SUPERADMIN_PASSWORD=
SONOBARR_SUPERADMIN_DISPLAY_NAME=

# Set this to "true" ONLY if you get locked out and need to forcefully reset 
# the admin account credentials upon the next container restart.
SONOBARR_SUPERADMIN_RESET=false

# Set to "true" to completely disable local password authentication. Use this 
# only if you are securing the application behind an external Identity Provider 
# (OIDC) like Authelia or Authentik.
OIDC_ONLY=false