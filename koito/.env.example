# ==============================================================================
# Koito Environment Variables
# ==============================================================================

# --- Koito Admin Account ---
# The initial administrator credentials created on the very first startup.
KOITO_DEFAULT_USERNAME=
KOITO_DEFAULT_PASSWORD=

# --- Subsonic / Navidrome Integration ---
# Koito needs to authenticate against Navidrome via the Subsonic API.
# You must provide the username, a generated token, and a salt.
# The format MUST be exactly: u=<username>&t=<token>&s=<salt>
KOITO_SUBSONIC_PARAMS=u=<navidrome_username>&t=<navidrome_token>&s=<navidrome_salt>

# --- ListenBrainz Scrobble Relay ---
# The user token required to relay listening data to your ListenBrainz profile.
# You can find this in your ListenBrainz account settings.
# Leave blank if you don't want to relay data externally.
KOITO_LBZ_RELAY_TOKEN=