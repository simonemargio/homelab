# ==============================================================================
# Beszel Environment Variables
# ==============================================================================

# SETUP:
# 1. Leave TOKEN and KEY blank for the first run.
# 2. Start the stack (the agent might show errors initially, this is normal).
# 3. Access the Beszel Hub GUI at http://<YOUR_SERVER_IP>:8090
# 4. Create an admin account and go to the dashboard.
# 5. Click "Add system", choose a name for your server.
# 6. The GUI will generate a public KEY and a TOKEN.
# 7. Copy those values, paste them below, and restart/redeploy the compose stack.

# The authorization token generated by the Beszel Hub
TOKEN=

# The cryptographic public key used for secure agent-hub communication
KEY=