# ==============================================================================
# Kopia Environment Variables
# ==============================================================================

# --- Container Identity ---
# The static hostname assigned to the container (e.g., "kopia-server").
# This must remain unchanged to preserve incremental backup history.
HOSTNAME=

# The system user running inside the Kopia container (usually "root" or "kopia").
USER=

# --- Encryption & Repository ---
# The master password used to encrypt the remote repository (e.g., on Hetzner).
# WARNING: If you lose this password, your offsite backups will be permanently 
# unreadable. Keep a secure copy offline!
KOPIA_PASSWORD=

# --- Web GUI Authentication ---
# The credentials required to access the Kopia Web Dashboard on port 8087.
KOPIA_SERVER_USERNAME=
KOPIA_SERVER_PASSWORD=