# ==============================================================================
# ezBookkeeping Environment Variables
# ==============================================================================

# --- Core & Security ---
# Log detail level (debug, info, warn, error). 'info' is recommended for production.
EBK_LOG_LEVEL=info

# CRITICAL: Encryption key used for securing your user data. 
# Generate a random 32-byte Base64 string via terminal: `openssl rand -base64 32`
# Do not lose this key after the database is created!
EBK_SECURITY_SECRET_KEY=

# IMPORTANT: Set to 'true' on first run so you can register your admin account.
# Once your account is created, change this to 'false' and redeploy the container
# to prevent unauthorized people from registering on your exposed domain.
EBK_USER_ENABLE_REGISTER=false

# --- Domain & Routing ---
# The external domain name used to access the application via Cloudflare Tunnel.
EBK_SERVER_DOMAIN=money.mydomain.com

# The full URL used by the application to generate links (e.g., in emails).
# Must include the protocol (https://).
EBK_SERVER_ROOT_URL=https://money.mydomain.com

# --- Database Setup ---
# We use SQLite3 as it is exceptionally fast, requires zero configuration, 
# and is perfect for a single-user homelab environment.
EBK_DATABASE_TYPE=sqlite3
# The internal path within the container where the SQLite DB file is saved.
EBK_DATABASE_DB_PATH=/ezbookkeeping/storage/ezbookkeeping.db

# --- UI Options ---
# Supports 'internal' (saves avatars to local storage) or 'gravatar' (fetches 
# based on email). Leave blank to disable avatars entirely.
EBK_USER_AVATAR_PROVIDER=gravatar

# Compresses web traffic to save bandwidth and improve load times.
EBK_SERVER_ENABLE_GZIP=true

# --- SMTP & Email Configuration ---
# Required if you want the app to send password reset links or verification emails.
EBK_MAIL_ENABLE_SMTP=true
EBK_MAIL_SMTP_HOST=      # e.g., smtp.gmail.com:465 or smtp.mailgun.org:587
EBK_MAIL_SMTP_USER=      # Your SMTP login email/username
EBK_MAIL_SMTP_PASSWD=    # Your SMTP password (or App-Specific Password)
EBK_MAIL_FROM_ADDRESS=   # The address emails will appear to come from (e.g., finance@mydomain.com)

# Leave false unless using a self-signed certificate on your mail server.
EBK_MAIL_SMTP_SKIP_TLS_VERIFY=false

# --- Account Verification ---
# Allows users to request password resets via email.
EBK_AUTH_ENABLE_FORGET_PASSWORD=true
# Sends an email to verify account ownership upon registration.
EBK_USER_ENABLE_EMAIL_VERIFY=true
# Prevents login until the email is successfully verified.
EBK_USER_ENABLE_FORCE_EMAIL_VERIFY=true